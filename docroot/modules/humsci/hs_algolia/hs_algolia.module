<?php

/**
 * @file
 * Contains hs_algolia.module.
 */

use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AnonymousUserSession;
use Drupal\Core\Site\Settings;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;
use Drupal\hs_algolia\Form\SettingsForm;
use Drupal\hs_algolia\Plugin\search_api\backend\HsAlgoliaBackend;
use Drupal\node\NodeInterface;
use Drupal\search_api\Entity\Index;
use Drupal\search_api\IndexInterface;
use Drupal\search_api\Plugin\search_api\datasource\ContentEntityTrackingManager;
use Drupal\search_api\ServerInterface;
use Drupal\search_api_algolia\Plugin\search_api\backend\SearchApiAlgoliaBackend;

/**
 * Maximum size in bytes of a single Algolia record on the free plan.
 */
const HS_ALGOLIA_RECORD_LIMIT = 10000;

/**
 * Number of records removed from Algolia in a single API request.
 */
const HS_ALGOLIA_DELETE_BATCH_SIZE = 100;

/**
 * Matches the token_or "or" syntax: [type:name|type:name|"fallback"].
 *
 * Search API's CustomValue processor scans with a pattern that rejects the
 * pipe, so these constructs are the only tokens that reach the objects alter
 * hook unresolved. Requiring both a colon and a pipe inside one bracket pair
 * keeps ordinary bracketed prose, such as "[1]" or "[Smith:2020]", out.
 *
 * @see \Drupal\search_api\Plugin\search_api\processor\CustomValue::addFieldValues()
 * @see \Drupal\token_or\TokenOrTokensPreAlter::tokensPreAlter()
 */
const HS_ALGOLIA_TOKEN_OR_PATTERN = '/\[[^\[\]]*:[^\[\]]*\|[^\[\]]*\]/';

/**
 * Search API server that every Training Hub site writes through.
 */
const HS_ALGOLIA_FEDERATED_SERVER_ID = 'hs_algolia_federated';

/**
 * Search API index whose records land in the shared Training Hub index.
 */
const HS_ALGOLIA_FEDERATED_INDEX_ID = 'hs_algolia_trainings';

/**
 * Training Hub facet attributes normalized so they match across sites.
 *
 * Each site's editors create their own terms, so the same value arrives as
 * "IT Services", "it services " and "IT  services". Normalizing at index time
 * merges them into one facet value. Display labels belong to the front end.
 */
const HS_ALGOLIA_FEDERATED_NORMALIZED_FIELDS = [
  'training_name',
  'provider',
  'audience',
  'product',
  'unit',
  'delivery_method',
];

/**
 * Servers whose Algolia credentials are supplied at runtime.
 *
 * The per-site server reads them from the Algolia settings form. The
 * federated server reads them from settings.php, shared across sites.
 *
 * @see \Drupal\hs_algolia\Overrides\ConfigOverrides
 */
const HS_ALGOLIA_RUNTIME_CREDENTIAL_SERVERS = [
  SettingsForm::SERVER_ID,
  HS_ALGOLIA_FEDERATED_SERVER_ID,
];

/**
 * Indexes whose Algolia index name is supplied at runtime.
 */
const HS_ALGOLIA_RUNTIME_NAME_INDEXES = [
  SettingsForm::INDEX_ID,
  HS_ALGOLIA_FEDERATED_INDEX_ID,
];

/**
 * Implements hook_module_implements_alter().
 *
 * The contrib entity delete hook queues a deletion for every Algolia index
 * that tracks the entity, whether or not the index is enabled. On a site that
 * has not enabled Algolia the index has no Algolia index name, and the queue
 * table rejects the resulting NULL. hs_algolia_entity_delete() adds the guard.
 */
function hs_algolia_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook === 'entity_delete') {
    unset($implementations['search_api_algolia']);
  }
}

/**
 * Implements hook_search_api_backend_info_alter().
 *
 * Clearing the shared Training Hub index must remove only this site's
 * records. The replacement subclasses the contributed backend, so the plugin
 * ID and every instanceof check stay the same.
 *
 * @see \Drupal\hs_algolia\Plugin\search_api\backend\HsAlgoliaBackend
 */
function hs_algolia_search_api_backend_info_alter(array &$backend_info): void {
  if (isset($backend_info['search_api_algolia'])) {
    $backend_info['search_api_algolia']['class'] = HsAlgoliaBackend::class;
  }
}

/**
 * Implements hook_entity_delete().
 */
function hs_algolia_entity_delete(EntityInterface $entity): void {
  if (hs_algolia_active_indexes()) {
    \Drupal::service('search_api_algolia.helper')->entityDelete($entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for search_api_server entities.
 *
 * The Algolia credentials are runtime overrides, so active configuration
 * holds empty strings and a configuration export never carries the key.
 *
 * Put the empty strings back. The backend plugin keeps its own configuration,
 * so the client built during this request still works.
 *
 * @see \Drupal\hs_algolia\Overrides\ConfigOverrides
 * @see hs_algolia_form_search_api_server_form_alter()
 */
function hs_algolia_search_api_server_presave(ServerInterface $server): void {
  if (!in_array($server->id(), HS_ALGOLIA_RUNTIME_CREDENTIAL_SERVERS, TRUE)) {
    return;
  }

  $backend_config = $server->get('backend_config') ?: [];
  $backend_config['application_id'] = '';
  $backend_config['api_key'] = '';
  $server->set('backend_config', $backend_config);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for search_api_index entities.
 *
 * The Algolia index name reaches active configuration the same way.
 *
 * Only removeIndex() reads this option during a save, and it is given the
 * unchanged original rather than this entity, so clearing a disabled index
 * still uses the site's real index name.
 *
 * @see \Drupal\search_api\Entity\Index::postSave()
 */
function hs_algolia_search_api_index_presave(IndexInterface $index): void {
  if (!in_array($index->id(), HS_ALGOLIA_RUNTIME_NAME_INDEXES, TRUE)) {
    return;
  }

  $options = $index->getOptions();
  $options['algolia_index_name'] = '';
  $index->setOptions($options);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 *
 * Search API stops tracking an unpublished node but leaves its Algolia record
 * in place until the next full reindex. Queue it for deletion so it leaves
 * search on the next cron run.
 */
function hs_algolia_node_update(NodeInterface $node): void {
  if ($node->isPublished() || !$node->getOriginal()?->isPublished()) {
    return;
  }

  if (hs_algolia_active_indexes()) {
    \Drupal::service('search_api_algolia.helper')->entityDelete($node);
  }
}

/**
 * Implements hook_content_access_per_node().
 *
 * Restricting a node through the access form writes node grants without
 * saving the node, so Search API never re-tracks the item and a record that
 * was already indexed would stay in a browser-queryable index. Queue the
 * record for removal when the anonymous user can no longer view it, and
 * re-track it either way so the next indexing run reflects the new grants.
 *
 * @see \Drupal\hs_algolia\EventSubscriber\AnonymousAccessSubscriber
 * @see \Drupal\content_access\Form\ContentAccessPageForm::submitForm()
 */
function hs_algolia_content_access_per_node(array $settings, NodeInterface $node): void {
  if (!hs_algolia_active_indexes()) {
    return;
  }

  // Grants have already been written by the time this hook fires, so the
  // access check reflects the setting that was just saved.
  if (!$node->access('view', new AnonymousUserSession())) {
    \Drupal::service('search_api_algolia.helper')->entityDelete($node);
  }

  \Drupal::service('search_api.entity_datasource.tracking_manager')
    ->trackEntityChange($node);
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * The bundle level access form rebuilds node grants for a whole content type
 * without saving a single node, and invokes no hook. Re-track the affected
 * content so the next indexing run re-checks anonymous access.
 *
 * @see \Drupal\Core\Form\FormBuilder::prepareForm()
 * @see content_access_mass_update()
 */
function hs_algolia_form_content_access_admin_settings_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = 'hs_algolia_content_access_bundle_submit';
}

/**
 * Re-track one content type after its access settings change.
 */
function hs_algolia_content_access_bundle_submit(array $form, FormStateInterface $form_state): void {
  $node_type = $form_state->getStorage()['node_type'] ?? NULL;

  if ($node_type) {
    hs_algolia_retrack_bundles([$node_type]);
  }
}

/**
 * Mark every indexed item of the given content types for reindexing.
 *
 * @param string[] $bundles
 *   Node bundles whose items should be re-tracked.
 *
 * @see \Drupal\hs_algolia\EventSubscriber\AnonymousAccessSubscriber
 */
function hs_algolia_retrack_bundles(array $bundles): void {
  $indexes = hs_algolia_active_indexes();

  if (!$indexes || !$bundles) {
    return;
  }

  $rows = \Drupal::database()->select('node_field_data', 'n')
    ->fields('n', ['nid', 'langcode'])
    ->condition('type', $bundles, 'IN')
    ->execute();

  $item_ids = [];
  foreach ($rows as $row) {
    $item_ids[] = ContentEntityTrackingManager::formatItemId('node', $row->nid, $row->langcode);
  }

  if (!$item_ids) {
    return;
  }

  foreach ($indexes as $index) {
    $valid = ContentEntityTrackingManager::filterValidItemIds($index, 'entity:node', $item_ids);
    if ($valid) {
      $index->trackItemsUpdated('entity:node', $valid);
    }
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for search_api_server_form.
 *
 * Algolia credentials are set per site on the Algolia settings form and
 * applied as config overrides, never stored on the server entity. Hide the
 * fields so nobody enters them here.
 */
function hs_algolia_form_search_api_server_form_alter(array &$form, FormStateInterface $form_state): void {
  $form_object = $form_state->getFormObject();
  $server = $form_object instanceof EntityFormInterface ? $form_object->getEntity() : NULL;
  if (!$server instanceof ServerInterface || $server->getBackendId() !== 'search_api_algolia') {
    return;
  }

  $form['backend_config']['application_id']['#access'] = FALSE;
  $form['backend_config']['api_key']['#access'] = FALSE;
  $form['backend_config']['help']['#markup'] = '<p>' . hs_algolia_credential_source($server) . '</p>';
}

/**
 * Describe where an Algolia server's credentials are set.
 *
 * The federated credentials are shared across sites, so they come from
 * environment settings and the per-site settings form never sees them.
 */
function hs_algolia_credential_source(ServerInterface $server): TranslatableMarkup {
  if ($server->id() === HS_ALGOLIA_FEDERATED_SERVER_ID) {
    return t('The application ID and API key are shared by every Training Hub site. They are set in settings.php from environment variables and cannot be edited here.');
  }

  return t('The application ID and API key are set on the <a href=":url">Algolia search settings</a> form and cannot be edited here.', [
    ':url' => Url::fromRoute('hs_algolia.settings')->toString(),
  ]);
}

/**
 * Implements hook_preprocess_HOOK() for search_api_server.
 *
 * Mask any cell holding algolia write key. Matching on the value rather than
 * the row label keeps this working if the contrib label changes, and only ever
 * hides the secret.
 *
 * @see \Drupal\search_api_algolia\Plugin\search_api\backend\SearchApiAlgoliaBackend::viewSettings()
 */
function hs_algolia_preprocess_search_api_server(array &$variables): void {
  $server = $variables['server'] ?? NULL;
  if (!$server instanceof ServerInterface || $server->getBackendId() !== 'search_api_algolia') {
    return;
  }

  $secret = (string) ($server->getBackendConfig()['api_key'] ?? '');
  if ($secret === '' || empty($variables['server_info_table']['#rows'])) {
    return;
  }

  $hidden = $server->id() === HS_ALGOLIA_FEDERATED_SERVER_ID
    ? t('Hidden. Set in settings.php from environment variables.')
    : t('Hidden. Set on the <a href=":url">Algolia search settings</a> form.', [
      ':url' => Url::fromRoute('hs_algolia.settings')->toString(),
    ]);

  foreach ($variables['server_info_table']['#rows'] as &$row) {
    if (isset($row['data'][1]) && is_string($row['data'][1]) && $row['data'][1] === $secret) {
      $row['data'][1] = $hidden;
    }
  }
}

/**
 * Implements hook_cron().
 *
 * The contrib module queues deletions in the search_api_algolia_deleted_items
 * table and expects a drush command to drain it. Drain it on cron instead,
 * deleting records from Algolia in bulk. Rows are removed only after Algolia
 * accepts the request, so a failed run is retried on the next one.
 */
function hs_algolia_cron(): void {
  $connection = \Drupal::database();
  $rows = $connection->select('search_api_algolia_deleted_items', 'd')
    ->fields('d', ['index_id', 'object_id'])
    ->execute()
    ->fetchAll();

  if (!$rows) {
    return;
  }

  $queued = [];
  foreach ($rows as $row) {
    $queued[$row->index_id][] = $row->object_id;
  }

  $logger = \Drupal::logger('hs_algolia');
  $indexes = hs_algolia_active_indexes();

  foreach ($queued as $index_name => $object_ids) {
    // Leave the rows in place. They drain once the index is enabled again.
    if (!isset($indexes[$index_name])) {
      $logger->notice('Skipped @count queued deletions for Algolia index @index: no enabled Search API index uses it.', [
        '@count' => count($object_ids),
        '@index' => $index_name,
      ]);
      continue;
    }

    /** @var \Drupal\search_api_algolia\Plugin\search_api\backend\SearchApiAlgoliaBackend $backend */
    $backend = $indexes[$index_name]->getServerInstance()->getBackend();
    $client = $backend->getAlgolia();

    foreach (array_chunk($object_ids, HS_ALGOLIA_DELETE_BATCH_SIZE) as $chunk) {
      try {
        $client->deleteObjects(indexName: $index_name, objectIDs: $chunk);
      }
      catch (\Throwable $e) {
        $logger->error('Unable to delete @count records from Algolia index @index: @message', [
          '@count' => count($chunk),
          '@index' => $index_name,
          '@message' => $e->getMessage(),
        ]);
        break;
      }

      $connection->delete('search_api_algolia_deleted_items')
        ->condition('index_id', $index_name)
        ->condition('object_id', $chunk, 'IN')
        ->execute();
    }
  }
}

/**
 * Get the Algolia-backed Search API indexes that can currently be written to.
 *
 * @return \Drupal\search_api\IndexInterface[]
 *   Enabled, writable indexes on an enabled Algolia server, keyed by their
 *   Algolia index name. Empty on a site that has not enabled Algolia.
 */
function hs_algolia_active_indexes(): array {
  $active = [];

  foreach (Index::loadMultiple() as $index) {
    $index_name = $index->getOption('algolia_index_name');
    if (!$index_name || !$index->status() || $index->isReadOnly() || !$index->isServerEnabled()) {
      continue;
    }

    if ($index->getServerInstance()->getBackend() instanceof SearchApiAlgoliaBackend) {
      $active[$index_name] = $index;
    }
  }

  return $active;
}

/**
 * Implements hook_search_api_algolia_objects_alter().
 *
 * Shapes each record before it is sent to Algolia.
 */
function hs_algolia_search_api_algolia_objects_alter(array &$objects, IndexInterface $index, array $items) {
  $canonical_host = hs_algolia_canonical_host();
  $current_host = \Drupal::requestStack()->getCurrentRequest()?->getSchemeAndHttpHost();

  // Records from every Training Hub site share one index, and the site name is
  // an editable label. The site directory is the same in every environment
  // and never changes, so it makes a stable facet key. The system.site UUID
  // cannot serve, because shared configuration gives every site the same one.
  $site_id = $index->id() === HS_ALGOLIA_FEDERATED_INDEX_ID
    ? HsAlgoliaBackend::siteId(\Drupal::getContainer()->getParameter('site.path'))
    : NULL;
  $missing_displays = [];

  foreach ($objects as $item_id => &$object) {
    // Fields that only describe how Search API tracked the item.
    unset($object['search_api_datasource'], $object['status']);

    // Put the title first so records are readable in the Algolia dashboard.
    if (isset($object['title'])) {
      $object = ['title' => $object['title']] + $object;
    }

    // Token data for any custom value field, matching what the CustomValue
    // processor would have passed to the token service.
    $entity = ($items[$item_id] ?? NULL)?->getOriginalObject()?->getValue();
    $token_data = $entity instanceof EntityInterface
      ? [$entity->getEntityTypeId() => $entity]
      : [];
    $unresolved = [];

    // Drupal renders with the default display when the configured one is
    // missing or disabled, and the default display can show fields that were
    // deliberately kept out of search, such as Training contacts.
    if ($entity instanceof EntityInterface) {
      foreach (array_keys($object) as $name) {
        if ($display_id = hs_algolia_missing_render_display($index, $name, $entity)) {
          unset($object[$name]);
          $missing_displays[$display_id] = $display_id;
        }
      }
    }

    foreach ($object as $name => &$value) {
      $property_path = $index->getField($name)?->getPropertyPath() ?? '';

      // A taxonomy reference with a single value arrives as a string. Always
      // send an array so the front end and Algolia facets see one shape.
      if (is_string($value) && str_contains($property_path, ':entity:name')) {
        $value = [$value];
      }

      // Custom value fields can still hold their tokens. Resolve them before
      // the host rewrite below, so a resolved URL is rewritten too.
      if (is_string($value) && str_contains($property_path, 'custom_value')) {
        $value = hs_algolia_replace_tokens($value, $token_data);
        if ($value === '') {
          $unresolved[] = $name;
        }
      }

      // Cron builds URLs from the current request, which on Acquia is the
      // internal hostname rather than the site's public domain.
      if ($canonical_host && $current_host && $canonical_host !== $current_host && is_string($value)) {
        $value = str_replace($current_host, $canonical_host, $value);
      }
    }
    unset($value);

    // Omit the attribute rather than sending an empty one.
    foreach ($unresolved as $name) {
      unset($object[$name]);
    }

    if ($site_id) {
      $object['site_id'] = $site_id;

      foreach (HS_ALGOLIA_FEDERATED_NORMALIZED_FIELDS as $name) {
        if (isset($object[$name])) {
          $object[$name] = hs_algolia_normalize_facet_value($object[$name]);
        }
      }
    }

    hs_algolia_trim_record($object);
  }
  unset($object);

  if ($missing_displays) {
    \Drupal::logger('hs_algolia')->warning('Omitted rendered HTML from Algolia index @index because these displays are missing or disabled: @displays.', [
      '@index' => $index->id(),
      '@displays' => implode(', ', $missing_displays),
    ]);
  }

  hs_algolia_cancel_queued_deletions($objects, $index);
}

/**
 * Normalize a facet value so the same term from different sites matches.
 *
 * @param mixed $value
 *   A string, or a list of strings for a multi-value field.
 *
 * @return mixed
 *   The value trimmed, with whitespace collapsed and lower-cased. A list has
 *   any values that became duplicates removed. Anything else is unchanged.
 */
function hs_algolia_normalize_facet_value(mixed $value): mixed {
  $normalize = fn($item) => is_string($item)
    ? mb_strtolower(trim(preg_replace('/[\s\p{Z}]+/u', ' ', $item)))
    : $item;

  if (is_array($value)) {
    return array_values(array_unique(array_map($normalize, $value), SORT_REGULAR));
  }

  return $normalize($value);
}

/**
 * Find the display a rendered item field needs but cannot use.
 *
 * @param \Drupal\search_api\IndexInterface $index
 *   Index the record belongs to.
 * @param string $name
 *   Record attribute, which may be a rendered item field.
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   Entity the record was built from.
 *
 * @return string|null
 *   ID of the missing or disabled view display, or NULL when the attribute is
 *   not a rendered item or its display can be used.
 *
 * @see \Drupal\search_api\Plugin\search_api\processor\RenderedItem::addFieldValues()
 */
function hs_algolia_missing_render_display(IndexInterface $index, string $name, EntityInterface $entity): ?string {
  $field = $index->getField($name);
  if ($field?->getPropertyPath() !== 'rendered_item') {
    return NULL;
  }

  // Resolve the view mode the same way the rendered item processor does.
  $entity_type_id = $entity->getEntityTypeId();
  $bundle = $entity->bundle();
  $view_modes = $field->getConfiguration()['view_mode']['entity:' . $entity_type_id] ?? [];
  $view_mode = $view_modes[$bundle] ?? ':default';
  if ($view_mode === ':default') {
    $view_mode = $view_modes[':default'] ?? NULL;
  }

  // The default display is what a missing one falls back to, so it is safe.
  if (!$view_mode || $view_mode === 'default') {
    return NULL;
  }

  $display_id = "$entity_type_id.$bundle.$view_mode";
  $display = \Drupal::entityTypeManager()->getStorage('entity_view_display')->load($display_id);

  return $display && $display->status() ? NULL : $display_id;
}

/**
 * Drop queued deletions for records that are about to be sent to Algolia.
 *
 * A node queued for deletion on unpublish stays queued until cron drains it.
 * If it is republished and reindexed first, the drain would remove the record
 * that was just sent, and Search API would still count the item as indexed.
 *
 * @param array $objects
 *   Records about to be sent, each with an objectID.
 * @param \Drupal\search_api\IndexInterface $index
 *   Index the records belong to.
 *
 * @see hs_algolia_cron()
 */
function hs_algolia_cancel_queued_deletions(array $objects, IndexInterface $index): void {
  $index_name = $index->getOption('algolia_index_name');
  $object_ids = array_filter(array_column($objects, 'objectID'));

  if (!$index_name || !$object_ids) {
    return;
  }

  \Drupal::database()->delete('search_api_algolia_deleted_items')
    ->condition('index_id', $index_name)
    ->condition('object_id', $object_ids, 'IN')
    ->execute();
}

/**
 * Replace any tokens left in a custom value field.
 *
 * Search API's CustomValue processor only hands a value to the token service
 * when its own pattern matches, and that pattern rejects the "or" syntax the
 * token_or module provides, so those values arrive here verbatim.
 *
 * @param string $value
 *   Field value, which may contain tokens.
 * @param array $token_data
 *   Token data keyed by token type, or empty for global tokens only.
 *
 * @return string
 *   The replaced value, or an empty string when nothing resolved.
 *
 * @see \Drupal\search_api\Plugin\search_api\processor\CustomValue::addFieldValues()
 * @see \Drupal\token_or\Token::replacePlain()
 */
function hs_algolia_replace_tokens(string $value, array $token_data): string {
  // Anything the CustomValue processor could resolve has already been
  // resolved, so a bare "[" here is ordinary content.
  if (!preg_match(HS_ALGOLIA_TOKEN_OR_PATTERN, $value)) {
    return $value;
  }

  $replaced = trim(\Drupal::token()->replacePlain($value, $token_data, ['clear' => TRUE]));

  // A value still holding the construct did not resolve against this entity.
  // Index nothing rather than the literal token text.
  return preg_match(HS_ALGOLIA_TOKEN_OR_PATTERN, $replaced) ? '' : $replaced;
}

/**
 * Get the site's canonical public host.
 *
 * @return string|null
 *   Scheme and host, or NULL when no canonical domain is configured.
 */
function hs_algolia_canonical_host(): ?string {
  $domain = \Drupal::config('domain_301_redirect.settings')->get('domain');
  if (!$domain) {
    return NULL;
  }

  // The stored value may or may not carry a scheme.
  if (!parse_url($domain, PHP_URL_SCHEME)) {
    $domain = 'https://' . $domain;
  }

  $parts = parse_url($domain);
  if (empty($parts['host'])) {
    return NULL;
  }

  return $parts['scheme'] . '://' . $parts['host'];
}

/**
 * Trim a record's rendered HTML until it fits Algolia's size limit.
 *
 * Algolia rejects any record over 10KB on the free plan. Long pages are
 * trimmed from the end rather than dropped entirely, so the record still
 * matches on everything above the cut. Enable this only on sites using a plan
 * with the smaller record limit.
 *
 * @param array $object
 *   Algolia record, altered by reference.
 */
function hs_algolia_trim_record(array &$object): void {
  if (!Settings::get('hs_algolia_trim_html') || empty($object['html'])) {
    return;
  }

  while (strlen(json_encode($object, JSON_UNESCAPED_SLASHES)) > HS_ALGOLIA_RECORD_LIMIT) {
    $words = explode(' ', $object['html']);
    array_pop($words);

    if (!$words) {
      break;
    }
    $object['html'] = implode(' ', $words);
  }
}
