<?php

/**
 * @file
 * su_humsci_profile.install
 */

use Drupal\Core\DrupalKernel;
use Drupal\Core\Extension\Dependency;
use Drupal\Core\Extension\Requirement\RequirementSeverity;
use Drupal\Core\Utility\UpdateException;

/**
 * Implements hook_requirements().
 */
function su_humsci_profile_requirements(mixed $phase) : array {
  $requirements = [];
  if ($phase == 'runtime') {
    $site_path = DrupalKernel::findSitePath(\Drupal::request());
    $site_path = explode('/', $site_path);
    $site_name = $site_path[1];

    $requirements['stanford_site_alias'] = [
      'title' => t('Stanford Site Alias'),
      'value' => $site_name,
      'severity' => RequirementSeverity::Info,
    ];
  }
  return $requirements;
}

/**
 * Implements hook_install_tasks().
 */
function su_humsci_profile_install_tasks(mixed &$install_state) : array {
  return ['su_humsci_profile_final_task' => []];
}

/**
 * Final profile installation task.
 */
function su_humsci_profile_final_task() : void {
  \Drupal::service('su_humsci_profile.post_install')->runTasks();
}

/**
 * Implements hook_update_last_removed().
 */
function su_humsci_profile_update_last_removed() : int {
  return 9758;
}

/**
 * Delete field_validation ruleset.
 */
function su_humsci_profile_update_9759() : string {
  $field_validation_rule = \Drupal::configFactory()->getEditable('field_validation.rule_set.config_pages_localist_events');
  $field_validation_rule->delete();
  return t('Deleted field_validation ruleset.');
}

/**
 * Uninstall the field_validation module.
 */
function su_humsci_profile_update_9760() : string {
  \Drupal::service('module_installer')->uninstall(['field_validation']);
  return t('Uninstalled the field_validation module.');
}

/**
 * Uninstall the config_filter module.
 */
function su_humsci_profile_update_9761(): string {
  $module = 'config_filter';
  if (\Drupal::moduleHandler()->moduleExists($module)) {
    \Drupal::service('module_installer')->uninstall([$module]);
    return t('Uninstalled the config_filter module.');
  }
  return t('config_filter module was already uninstalled.');
}

/**
 * Remove permissions related to hs_page_reports module.
 */
function su_humsci_profile_update_11000(): string {
  $permissions = [
    'view 404 reports',
    'view 403 reports',
    'rebuild cache access',
  ];

  $roles_changed = 0;
  $roles = \Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple();
  /** @var \Drupal\user\Entity\Role $role */
  foreach ($roles as $role) {
    $changed = FALSE;
    foreach ($permissions as $permission) {
      if ($role->hasPermission($permission)) {
        $role->revokePermission($permission);
        $changed = TRUE;
      }
    }
    if ($changed) {
      $roles_changed++;
      $role->save();
    }
  }
  return t('Revoked hs_page_reports permissions from @roles_changed roles.', ['@roles_changed' => $roles_changed]);
}

/**
 * Uninstall the hs_page_reports module.
 */
function su_humsci_profile_update_11001(): string {
  $module = 'hs_page_reports';
  if (\Drupal::moduleHandler()->moduleExists($module)) {
    \Drupal::service('module_installer')->uninstall([$module]);
    return t('Uninstalled the hs_page_reports module.');
  }
  return t('hs_page_reports module was already uninstalled.');
}

/**
 * Add hs_training content type to single_content_sync allow list.
 */
function su_humsci_profile_update_11002(): string {
  $config = \Drupal::configFactory()->getEditable('single_content_sync.settings');
  $allowed = $config->get('allowed_entity_types');
  if (!in_array('hs_training', $allowed['node'] ?? [])) {
    $allowed['node'][] = 'hs_training';
    $config->set('allowed_entity_types', $allowed)->save();
    return t('Added hs_training to single_content_sync allowed node types.');
  }
  return t('hs_training was already in single_content_sync allowed node types.');
}

/**
 * Enable Feeds and Feeds Tamper modules on all sites.
 */
function su_humsci_profile_update_11003(): string {
  $modules = ['feeds', 'feeds_tamper'];
  $to_install = [];
  foreach ($modules as $module) {
    if (!\Drupal::moduleHandler()->moduleExists($module)) {
      $to_install[] = $module;
    }
  }
  if (empty($to_install)) {
    return t('Feeds and Feeds Tamper modules were already enabled.');
  }
  \Drupal::service('module_installer')->install($to_install);
  return t('Enabled modules: @modules.', ['@modules' => implode(', ', $to_install)]);
}

/**
 * Add hs_project content type to single_content_sync allow list.
 */
function su_humsci_profile_update_11004(): string {
  $config = \Drupal::configFactory()->getEditable('single_content_sync.settings');
  $allowed = $config->get('allowed_entity_types');
  if (!in_array('hs_project', $allowed['node'] ?? [])) {
    $allowed['node'][] = 'hs_project';
    $config->set('allowed_entity_types', $allowed)->save();
    return t('Added hs_project to single_content_sync allowed node types.');
  }
  return t('hs_project was already in single_content_sync allowed node types.');
}

/**
 * Uninstall the unused video embed modules without removing site configuration.
 */
function su_humsci_profile_update_11005(): string {
  $modules = array_values(array_filter(['video_embed_media', 'video_embed_field'], fn ($module) => \Drupal::moduleHandler()->moduleExists($module)));
  if ($modules === []) {
    return t('The video embed modules were already uninstalled.');
  }

  // Sites can add dependencies after the audit. Never uninstall those modules.
  $dependents = [];
  foreach (\Drupal::service('extension.list.module')->getAllInstalledInfo() as $name => $info) {
    if (in_array($name, $modules, TRUE)) {
      continue;
    }
    foreach ($info['dependencies'] as $dependency) {
      if (in_array(Dependency::createFromString($dependency)->getName(), $modules, TRUE)) {
        $dependents[] = $name;
        break;
      }
    }
  }
  if ($dependents !== []) {
    throw new UpdateException(t('Video embed uninstall blocked by dependent modules: @modules.', ['@modules' => implode(', ', $dependents)]));
  }

  $installer = \Drupal::service('module_installer');
  $reasons = $installer->validateUninstall($modules);
  if ($reasons !== []) {
    throw new UpdateException(t('Video embed uninstall blocked: @reasons', ['@reasons' => implode('; ', array_merge(...array_values($reasons)))]));
  }
  foreach (\Drupal::service('entity_field.deleted_fields_repository')->getFieldDefinitions() as $field) {
    if ($field->getType() === 'video_embed_field') {
      throw new UpdateException(t('Video embed uninstall blocked by a field awaiting purge: @field.', ['@field' => $field->getName()]));
    }
  }

  // Repair the known stale mapping while preserving other site customizations.
  $migration = \Drupal::configFactory()->getEditable('migrate_plus.migration.hs_events_importer');
  $migration_data = $migration->getRawData();
  $mapping = 'process.field_hs_event_video.1';
  $mapping_changed = $migration->get($mapping . '.plugin') === 'entity_generate'
    && $migration->get($mapping . '.entity_type') === 'media'
    && $migration->get($mapping . '.bundle') === 'video'
    && $migration->get($mapping . '.value_key') === 'field_media_video_embed_field';
  if ($mapping_changed) {
    $migration_data['process']['field_hs_event_video'][1]['value_key'] = 'field_media_oembed_video';
  }

  // Uninstall can delete dependent config, including ignored customizations.
  // Review unexpected references instead of letting that cascade remove them.
  $storage = \Drupal::service('config.storage');
  $references = [];
  foreach ($storage->listAll() as $name) {
    if ($name === 'core.extension') {
      continue;
    }
    $data = $name === $migration->getName() ? $migration_data : $storage->read($name);
    if ($data === FALSE) {
      throw new UpdateException(t('Could not check configuration @name before video embed uninstall.', ['@name' => $name]));
    }
    $serialized = serialize($data);
    if (str_contains($serialized, 'video_embed_field') || str_contains($serialized, 'video_embed_media')) {
      $references[] = $name;
    }
  }
  if ($references !== []) {
    throw new UpdateException(t('Video embed uninstall blocked by configuration requiring review: @config.', ['@config' => implode(', ', $references)]));
  }

  if ($mapping_changed) {
    $migration->set($mapping . '.value_key', 'field_media_oembed_video')->save();
  }
  if (!$installer->uninstall($modules, FALSE)) {
    throw new UpdateException(t('The video embed modules could not be uninstalled. Keep their code available and review the site.'));
  }
  return t('Uninstalled @count video embed modules and repaired @mappings event migration mappings.', [
    '@count' => count($modules),
    '@mappings' => (int) $mapping_changed,
  ]);
}
