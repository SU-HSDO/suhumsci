{#
/**
 * @file
 * Fallback preview shown in the paragraph widget (the "preview" view mode).
 *
 * A closed paragraph in the editor shows a small preview. Paragraphs that have
 * their own preview template use that; everything else lands here.
 *
 * The components that ship with the site (their machine names start with hs_ or
 * stanford_) can render a real preview, so we show it. Anything else was built
 * on the site itself and has no preview to show, so instead of dumping its raw
 * fields we just show its name and a short "no preview" note.
 *
 * Why match hs_/stanford_ rather than look for a "custom" name? Site-built
 * components only get the custm_ prefix on production, so on local/dev/stage
 * they wouldn't match. The hs_/stanford_ names are the same on every
 * environment, so they're the safe thing to check for.
 */
#}
<div class="paragraph-admin-preview">
  <div{{ wrapper_attributes }}>
    {% if paragraph.bundle starts with 'hs_' or paragraph.bundle starts with 'stanford_' %}
      {% include '@humsci_basic/components/paragraph.html.twig' %}
    {% else %}
      <h2>{{ paragraph.getParagraphType.label }}</h2>
      <p>No preview available for this component</p>
    {% endif %}
  </div>
</div>
