diff --git a/src/EventSubscriber/ImagemagickEventSubscriber.php b/src/EventSubscriber/ImagemagickEventSubscriber.php
index 8564507cb1b03e8f0e6c7c5f74c43c81f7f946ec..25bd6edd35c6b9647d1bb06caa15b135ec391018 100644
--- a/src/EventSubscriber/ImagemagickEventSubscriber.php
+++ b/src/EventSubscriber/ImagemagickEventSubscriber.php
@@ -342,14 +342,26 @@ class ImagemagickEventSubscriber implements EventSubscriberInterface {
     $this->doEnsureDestinationLocalPath($arguments);
     $this->ensureDestinationFormat($arguments);
 
-    // Coalesce Animated GIFs, if required.
-    if (empty($arguments->find('/^\-coalesce/')) && (bool) $this->imagemagickSettings->get('advanced.coalesce') && in_array($arguments->getSourceFormat(), [
-      'GIF',
-      'GIF87',
-    ])) {
+    if ($this->imagemagickSettings->get('advanced.coalesce')) {
+      // Coalesce Animated GIFs, if required.
       $file_md = $this->fileMetadataManager->uri($arguments->getSource());
-      if ($file_md && $file_md->getMetadata(ImagemagickToolkit::FILE_METADATA_PLUGIN_ID, 'frames_count') > 1) {
-        $arguments->add(["-coalesce"], ArgumentMode::PostSource, 0);
+      if (empty($arguments->find('/^\-coalesce/')) && in_array($arguments->getSourceFormat(), [
+        'GIF',
+        'GIF87',
+      ])) {
+        if ($file_md && $file_md->getMetadata(ImagemagickToolkit::FILE_METADATA_PLUGIN_ID, 'frames_count') > 1) {
+          $arguments->add(["-coalesce"], ArgumentMode::PostSource, 0);
+        }
+      }
+
+      // When the destination format differs from the source, the coalesce option
+      // is enabled and the destination format differs and is gif or webp, then
+      // process all frames.
+      $destination_format = $arguments->getDestinationFormat() ?: $arguments->getSourceFormat();
+      if ($arguments->getSourceFormat() !== $destination_format && $file_md && $file_md->getMetadata(ImagemagickToolkit::FILE_METADATA_PLUGIN_ID, 'frames_count') > 1) {
+        if (in_array($destination_format, ['GIF', 'GIF87', 'WEBP'])) {
+          $arguments->setSourceFrames('[0-' . $file_md->getMetadata(ImagemagickToolkit::FILE_METADATA_PLUGIN_ID, 'frames_count') . ']');
+        }
       }
     }
 
