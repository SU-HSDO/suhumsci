diff --git a/tests/src/Functional/ImagemagickToolkitCoalesceTest.php b/tests/src/Functional/ImagemagickToolkitCoalesceTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..8e30524e6c9cff1895d28a11b073ba6a365af3df
--- /dev/null
+++ b/tests/src/Functional/ImagemagickToolkitCoalesceTest.php
@@ -0,0 +1,112 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\imagemagick\Functional;
+
+use Drupal\Tests\BrowserTestBase;
+use Drupal\file_mdm\FileMetadataManagerInterface;
+use Drupal\imagemagick\ArgumentMode;
+use Drupal\imagemagick\Plugin\ImageToolkit\ImagemagickToolkit;
+use Drupal\Tests\imagemagick\Kernel\ToolkitSetupTrait;
+
+/**
+ * Tests the advanced coalesce functionality for multi-frame images.
+ *
+ * @group imagemagick
+ */
+class ImagemagickToolkitCoalesceTest extends BrowserTestBase {
+  use ToolkitSetupTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'imagemagick',
+    'sophron',
+    'file_mdm',
+    'user',
+  ];
+
+  /**
+   * The default theme.
+   *
+   * @var string
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->prepareImageFileHandling();
+  }
+
+  /**
+   * Tests that coalesce is applied when converting a multi-frame image.
+   *
+   * This test uses the ToolkitSetupTrait to configure the ImageMagick toolkit.
+   * It sets advanced.coalesce to TRUE, loads a multi-frame GIF from the
+   * module's misc/ directory, converts it to WebP, saves the output file,
+   * and verifies that the generated command line includes the coalesce flag.
+   *
+   * @param string $toolkit_id
+   *   The id of the toolkit to set up.
+   * @param string $toolkit_config
+   *   The configuration object of the toolkit to set up.
+   * @param array $toolkit_settings
+   *   An associative array of toolkit settings.
+   *
+   * @dataProvider providerToolkitConfiguration
+   */
+  public function testAdvancedCoalesceAppliedForMultiFrameImage(string $toolkit_id, string $toolkit_config, array $toolkit_settings): void {
+    // Set up the toolkit using the trait.
+    $this->setUpToolkit($toolkit_id, $toolkit_config, $toolkit_settings);
+
+    // Force the system image toolkit to 'imagemagick'.
+    $this->container->get('config.factory')->getEditable('system.image')
+      ->set('toolkit', 'imagemagick')
+      ->save();
+
+    // Set advanced.coalesce to TRUE.
+    $config = $this->container->get('config.factory')->getEditable('imagemagick.settings');
+    $config->set('advanced.coalesce', TRUE)->save();
+
+    // Get the path to the multi-frame GIF image.
+    $module_handler = $this->container->get('extension.list.module');
+    $gif_path = $module_handler->getPath('imagemagick') . '/misc/test-multi-frame.gif';
+
+    // Load the image using the image factory.
+    $image = $this->imageFactory->get($gif_path);
+    $this->assertTrue($image->isValid(), 'Expected the multi-frame image to be valid, but it was not.');
+
+    // Convert the image to WebP. This conversion should trigger the
+    // advanced coalesce logic.
+    $this->assertTrue($image->convert('webp'), 'Expected image conversion to WebP to succeed.');
+
+    // Define a destination path in the test directory and save the converted
+    // image.
+    $destination = $this->testDirectory . '/coalesced.webp';
+    $this->assertTrue($image->save($destination), 'Expected the converted image to be saved successfully.');
+
+    // Verify that the file exists on disk.
+    $real_path = $this->container->get('file_system')->realpath($destination);
+    $this->assertNotFalse($real_path, "Expected the file '$real_path' to exist on disk.");
+
+    // Verify that the converted image is multi-frame.
+    $fmdm = \Drupal::service(FileMetadataManagerInterface::class);
+    $file_md = $fmdm->uri($destination);
+    $this->assertTrue(($file_md && $file_md->getMetadata(ImagemagickToolkit::FILE_METADATA_PLUGIN_ID, 'frames_count') > 1), "Expected the converted image to be multi-frame.");
+
+    // Retrieve the command line debug string representing the final arguments.
+    /** @var \Drupal\imagemagick\Plugin\ImageToolkit\ImagemagickToolkit $toolkit_instance */
+    $toolkit_instance = $image->getToolkit();
+    $debug = $toolkit_instance->arguments()->toDebugString(ArgumentMode::PostSource);
+
+    // Assert that the debug string includes the advanced coalesce flag.
+    $this->assertStringContainsString('[-coalesce]', $debug, 'Expected the command line to include "[-coalesce]". Debug string: ' . $debug);
+  }
+
+}
